{
  "distro_name": "PersisOS",
  "version": "2.0",
  "debootstrap_variant": "minbase",
  "apt_mirror": "http://deb.debian.org/debian",
  "apt_components": [
    "main",
    "contrib",
    "non-free",
    "non-free-firmware"
  ],
  "hostname": "persisos",
  "locale": "en_US.UTF-8",
  "timezone": "UTC",
  "root_password": null,
  "live_username": "user",
  "live_user_password": "user",
  "packages": [
    "firmware-linux",
    "firmware-linux-free",
    "firmware-linux-nonfree",
    "libegl-mesa0",
    "libglx-mesa0",
    "libgl1-mesa-dri",
    "mesa-va-drivers",
    "mesa-vdpau-drivers",
    "mesa-vulkan-drivers",
    "kde-plasma-desktop",
    "xserver-xorg",
    "kwin-x11",
    "kwin-wayland",
    "plasma-workspace",
    "breeze",
    "breeze-icon-theme",
    "breeze-gtk-theme",
    "kde-config-gtk-style",
    "qt6-gtk-platformtheme",
    "adwaita-icon-theme",
    "gnome-themes-extra",
    "plasma-widgets-addons",
    "plasma-systemmonitor",
    "plasma-disks",
    "systemsettings",
    "kinfocenter",
    "polkit-kde-agent-1",
    "plasma-nm",
    "plasma-pa",
    "bluedevil",
    "bluez",
    "pipewire",
    "pipewire-pulse",
    "pipewire-alsa",
    "rtkit",
    "vlc",
    "pciutils",
    "libspa-0.2-bluetooth",
    "wireplumber",
    "wpasupplicant",
    "dolphin",
    "kio-extras",
    "gwenview",
    "kate",
    "konsole",
    "kcalc",
    "ark",
    "okular",
    "kde-spectacle",
    "p7zip-full",
    "kdegraphics-thumbnailers",
    "ffmpegthumbs",
    "partitionmanager",
    "firefox-esr",
    "cups",
    "print-manager",
    "xdg-user-dirs",
    "xdg-utils",
    "xdg-desktop-portal-kde",
    "ca-certificates",
    "fonts-noto-core",
    "fonts-noto-color-emoji",
    "network-manager",
    "network-manager-openvpn",
    "power-profiles-daemon",
    "upower",
    "udisks2",
    "plasma-runners-addons",
    "fastfetch",
    "bash-completion",
    "man-db",
    "manpages",
    "htop",
    "usbutils",
    "systemd-timesyncd",
    "squashfs-tools",
    "live-boot-initramfs-tools",
    "firmware-iwlwifi",
    "firmware-realtek",
    "firmware-brcm80211",
    "firmware-atheros",
    "firmware-mediatek",
    "powerdevil",
    "kscreen",
    "live-config-systemd",
    "fwupd",
    "pkexec",
    "polkitd",
    "parted",
    "gdisk",
    "dosfstools",
    "ntfs-3g",
    "os-prober",
    "efibootmgr",
    "cryptsetup",
    "cryptsetup-initramfs",
    "apparmor",
    "apparmor-profiles",
    "nftables",
    "unattended-upgrades",
    "sddm",
    "calamares",
    "qml-module-qtquick2",
    "qml-module-qtquick-controls2",
    "qml-module-qtquick-window2",
    "qml-module-qtquick-dialogs",
    "qml-module-org-kde-kconfig",
    "qml-module-org-kde-kquickcontrolsaddons",
    "qml-module-org-kde-kirigami2",
    "sddm-theme-breeze"
  ],
  "exclude_packages": [
    "plasma-discover",
    "plasma-welcome",
    "desktop-base",
    "kwallet-pam",
    "kwalletmanager",
    "kde-config-welcome",
    "plasma-browser-integration"
  ],
  "pre_chroot_scripts": [
    "hooks/desktop/stage-assets.sh"
  ],
  "post_install_scripts": [
    "hooks/desktop/automatic-updates.sh",
    "hooks/desktop/firewall.sh",
    "hooks/desktop/sysctl.sh",
    "hooks/desktop/plasma-assets.sh",
    "hooks/desktop/theme-command.sh",
    "hooks/desktop/desktop-defaults.sh",
    "hooks/desktop/live-autologin.sh",
    "hooks/desktop/icons-and-launchers.sh",
    "hooks/desktop/calamares.sh",
    "hooks/desktop/login-branding.sh",
    "hooks/desktop/cleanup-assets.sh"
  ],
  "boot_append": "quiet splash",
  "squashfs_compression": "xz",
  "iso_volume_id": "PERSISOS_2_0_ARM64",
  "iso_filename": "PersisOS-2.0-arm64.iso",
  "architecture": "arm64",
  "suite": "trixie",
  "apt_sources": [
    "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware",
    "deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware",
    "deb http://deb.debian.org/debian-security trixie-security main contrib non-free non-free-firmware"
  ],
  "grub_background": "assets/wallpapers/PersisOS-1/contents/images/2560x1600.png",
  "install_recommends": false,
  "services": {
    "enable": [
      "sddm",
      "NetworkManager",
      "bluetooth",
      "power-profiles-daemon",
      "fstrim.timer",
      "fwupd-refresh.timer",
      "apparmor",
      "unattended-upgrades",
      "nftables",
      "systemd-timesyncd",
      "cups"
    ]
  },
  "os_release": {
    "NAME": "PersisOS",
    "PRETTY_NAME": "PersisOS 2.0",
    "ID": "persisos",
    "ID_LIKE": "debian",
    "VERSION": "2.0",
    "VERSION_ID": "2.0",
    "VARIANT": "Desktop",
    "VARIANT_ID": "desktop",
    "LOGO": "persisos",
    "HOME_URL": "https://github.com/arshavirm/PersisOS",
    "SUPPORT_URL": "https://github.com/arshavirm/PersisOS/issues",
    "BUG_REPORT_URL": "https://github.com/arshavirm/PersisOS/issues"
  }
}
