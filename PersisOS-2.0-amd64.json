{
  "distro_name": "PersisOS",
  "version": "2.0",
  "architecture": "amd64",
  "suite": "trixie",
  "debootstrap_variant": "minbase",
  "apt_mirror": "http://deb.debian.org/debian",
  "apt_components": [
    "main",
    "contrib",
    "non-free",
    "non-free-firmware"
  ],
  "apt_sources": [
    "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware",
    "deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware",
    "deb http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware"
  ],
  "hostname": "persisos",
  "locale": "en_US.UTF-8",
  "timezone": "UTC",
  "root_password": null,
  "live_username": "user",
  "live_user_password": "user",
  "packages": [
    "firmware-linux",
    "firmware-linux-free",
    "firmware-linux-nonfree",
    "firmware-iwlwifi",
    "firmware-realtek",
    "firmware-brcm80211",
    "firmware-atheros",
    "firmware-mediatek",
    "intel-microcode",
    "amd64-microcode",
    "xserver-xorg-video-all",
    "libgl1-mesa-dri",
    "libglx-mesa0",
    "mesa-vulkan-drivers",
    "mesa-va-drivers",
    "mesa-vdpau-drivers",
    "libvulkan1",
    "vulkan-tools",
    "va-driver-all",
    "vdpau-driver-all",
    "kde-plasma-desktop",
    "kwin-x11",
    "kwin-wayland",
    "plasma-workspace",
    "breeze",
    "breeze-gtk-theme",
    "plasma-nm",
    "plasma-pa",
    "bluedevil",
    "power-profiles-daemon",
    "pipewire",
    "pipewire-pulse",
    "pipewire-alsa",
    "pipewire-audio",
    "wireplumber",
    "gstreamer1.0-pipewire",
    "libspa-0.2-bluetooth",
    "dolphin",
    "kate",
    "konsole",
    "gwenview",
    "okular",
    "ark",
    "unrar",
    "p7zip-full",
    "zip",
    "unzip",
    "kde-spectacle",
    "kcalc",
    "partitionmanager",
    "firefox-esr",
    "plasma-discover",
    "plasma-discover-backend-flatpak",
    "flatpak",
    "fonts-vazirmatn",
    "fonts-noto-core",
    "fonts-freefont-ttf",
    "libreoffice-writer",
    "libreoffice-calc",
    "libreoffice-plasma",
    "zenity",
    "cabextract",
    "cups",
    "cups-filters",
    "cups-client",
    "system-config-printer",
    "print-manager",
    "fwupd",
    "calamares",
    "qml-module-org-kde-kirigami2",
    "qml-module-qtquick2",
    "qml-module-qtquick-controls2",
    "qml-module-qtquick-layouts",
    "qml-module-qtquick-window2",
    "parted",
    "gdisk",
    "dosfstools",
    "e2fsprogs",
    "ntfs-3g",
    "cryptsetup",
    "os-prober",
    "efibootmgr",
    "apparmor",
    "apparmor-profiles",
    "apparmor-utils",
    "nftables",
    "unattended-upgrades",
    "libpam-systemd",
    "sddm",
    "sddm-theme-breeze",
    "plymouth",
    "plymouth-themes",
    "vlc",
    "curl",
    "wget",
    "plasma-systemmonitor",
    "squashfs-tools",
    "rsync"
  ],
  "exclude_packages": [
    "plasma-welcome",
    "desktop-base",
    "kwallet-pam",
    "kwalletmanager",
    "kde-config-welcome",
    "plasma-browser-integration"
  ],
  "pre_chroot_scripts": [
    "hooks/desktop/stage-assets.sh"
  ],
  "post_install_scripts": [
    "hooks/desktop/automatic-updates.sh",
    "hooks/desktop/firewall.sh",
    "hooks/desktop/sysctl.sh",
    "hooks/desktop/plasma-assets.sh",
    "hooks/desktop/theme-command.sh",
    "hooks/desktop/desktop-defaults.sh",
    "hooks/desktop/live-autologin.sh",
    "hooks/desktop/icons-and-launchers.sh",
    "hooks/desktop/flatpak.sh",
    "hooks/common/install-calamares.sh",
    "hooks/desktop/login-branding.sh",
    "hooks/common/cleanup-assets.sh"
  ],
  "boot_append": "quiet splash",
  "squashfs_compression": "xz",
  "grub_background": "assets/wallpapers/Lake/contents/images/2560x1600.png",
  "os_release": {
    "NAME": "PersisOS",
    "PRETTY_NAME": "PersisOS 2.0 (trixie) AMD64",
    "ID": "persisos",
    "ID_LIKE": "debian",
    "VERSION": "2.0",
    "VERSION_ID": "2.0",
    "VARIANT": "Desktop",
    "VARIANT_ID": "desktop",
    "LOGO": "persisos",
    "HOME_URL": "https://github.com/PersisOS/PersisOS",
    "SUPPORT_URL": "https://github.com/PersisOS/PersisOS",
    "BUG_REPORT_URL": "https://github.com/PersisOS/PersisOS/issues"
  },
  "install_recommends": false,
  "services": {
    "enable": [
      "sddm",
      "NetworkManager",
      "bluetooth",
      "power-profiles-daemon",
      "fstrim.timer",
      "fwupd-refresh.timer",
      "apparmor",
      "unattended-upgrades",
      "nftables",
      "cups"
    ]
  }
}
