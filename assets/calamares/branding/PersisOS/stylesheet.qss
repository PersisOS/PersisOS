QWidget {
    font-family: "Noto Sans";
    color: #24202b;
}

#sidebarApp {
    background: #201b29;
    color: #e5deed;
}

#sidebarApp QWidget, #sidebarApp QLabel {
    color: #e5deed;
}

QMainWindow, QDialog {
    background: #f5f2f8;
}

QPushButton {
    min-height: 34px;
    padding: 0 16px;
    border: 1px solid #d8d1df;
    border-radius: 8px;
    background: #ffffff;
    color: #30263b;
    font-weight: 600;
}

QPushButton:hover {
    border-color: #a66ac7;
    background: #f3eafa;
}

QPushButton:pressed {
    background: #e8d7f2;
}

QPushButton:disabled {
    color: #9992a0;
    background: #eeebf0;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid #d7d0dd;
    border-radius: 7px;
    background: #ffffff;
    selection-background-color: #8247bd;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #9758bb;
}

QListView, QTreeView, QTableView {
    border: 1px solid #e1dbe6;
    border-radius: 7px;
    background: #ffffff;
    alternate-background-color: #f8f6fa;
    selection-background-color: #eee1f6;
    selection-color: #2d2038;
}

QProgressBar {
    min-height: 8px;
    border: 0;
    border-radius: 4px;
    background: #e8e2ec;
    text-align: center;
}

QProgressBar::chunk {
    border-radius: 4px;
    background: #9758bb;
}
