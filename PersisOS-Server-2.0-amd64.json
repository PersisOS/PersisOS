{
  "distro_name": "PersisOS Server",
  "version": "2.0",
  "debootstrap_variant": "minbase",
  "apt_mirror": "http://deb.debian.org/debian",
  "hostname": "persisos-server",
  "locale": "en_US.UTF-8",
  "timezone": "UTC",
  "root_password": null,
  "live_username": "admin",
  "live_user_password": "persisos",
  "packages": [
    "firmware-linux",
    "firmware-linux-free",
    "firmware-linux-nonfree",
    "firmware-iwlwifi",
    "firmware-realtek",
    "firmware-brcm80211",
    "firmware-atheros",
    "firmware-mediatek",
    "intel-microcode",
    "amd64-microcode",
    "ca-certificates",
    "curl",
    "wget",
    "gnupg",
    "bash-completion",
    "network-manager",
    "wpasupplicant",
    "openssh-server",
    "openssh-client",
    "nftables",
    "fail2ban",
    "apparmor",
    "apparmor-profiles",
    "auditd",
    "libpam-pwquality",
    "unattended-upgrades",
    "needrestart",
    "chrony",
    "vim",
    "nano",
    "less",
    "man-db",
    "tmux",
    "htop",
    "ncdu",
    "jq",
    "git",
    "rsync",
    "tree",
    "lsof",
    "strace",
    "psmisc",
    "unzip",
    "zip",
    "logrotate",
    "sysstat",
    "iproute2",
    "iputils-ping",
    "dnsutils",
    "traceroute",
    "tcpdump",
    "ethtool",
    "socat",
    "smartmontools",
    "lm-sensors",
    "nvme-cli",
    "lvm2",
    "mdadm",
    "cryptsetup",
    "cryptsetup-initramfs",
    "btrfs-progs",
    "xfsprogs",
    "dosfstools",
    "parted",
    "nfs-common",
    "cifs-utils",
    "acl",
    "attr",
    "podman",
    "podman-compose",
    "qemu-guest-agent"
  ],
  "exclude_packages": [],
  "pre_chroot_scripts": [],
  "post_install_scripts": [
    "hooks/server/automatic-updates.sh",
    "hooks/server/firewall.sh",
    "hooks/server/sysctl.sh",
    "hooks/server/journald.sh",
    "hooks/server/password-policy.sh",
    "hooks/server/login-branding.sh"
  ],
  "boot_append": "quiet noautologin",
  "squashfs_compression": "xz",
  "iso_volume_id": "PERSISOS_SERVER_2_0",
  "iso_filename": "PersisOS-Server-2.0-amd64.iso",
  "architecture": "amd64",
  "suite": "trixie",
  "apt_components": [
    "main",
    "contrib",
    "non-free",
    "non-free-firmware"
  ],
  "apt_sources": [
    "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware",
    "deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware",
    "deb http://deb.debian.org/debian-security trixie-security main contrib non-free non-free-firmware"
  ],
  "installer_enabled": false,
  "grub_background": "assets/wallpapers/PersisOS-1/contents/images/2560x1600.png",
  "install_recommends": false,
  "os_release": {
    "NAME": "PersisOS Server",
    "PRETTY_NAME": "PersisOS Server 2.0",
    "ID": "persisos",
    "ID_LIKE": "debian",
    "VERSION": "2.0",
    "VERSION_ID": "2.0",
    "VARIANT": "Server",
    "VARIANT_ID": "server"
  },
  "services": {
    "enable": [
      "NetworkManager",
      "chrony",
      "apparmor",
      "auditd",
      "nftables",
      "fail2ban",
      "unattended-upgrades",
      "fstrim.timer",
      "qemu-guest-agent"
    ],
    "disable": [
      "ssh"
    ]
  }
}
